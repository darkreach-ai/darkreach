#!/usr/bin/env bash
# Pre-commit hook for darkreach
# Install: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
#
# Runs fast checks only (~5-10s). Full tests run in pre-push and CI.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

pass() { echo -e "${GREEN}PASS${NC} $1"; }
fail() { echo -e "${RED}FAIL${NC} $1"; exit 1; }

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 1. Check Rust formatting (fast — reads only, no compilation)
RUST_STAGED=$(echo "$STAGED_FILES" | grep '\.rs$' || true)
if [ -n "$RUST_STAGED" ]; then
    echo "Running cargo fmt --check..."
    if cargo fmt -- --check 2>/dev/null; then
        pass "cargo fmt"
    else
        fail "cargo fmt -- run 'cargo fmt' to fix"
    fi

    echo "Running cargo check..."
    if cargo check --quiet 2>&1 | tail -5; then
        pass "cargo check"
    else
        fail "cargo check — fix type errors before committing"
    fi
else
    echo "No Rust files staged, skipping cargo fmt/check"
fi

# 2. Check frontend types (only if frontend files are staged)
FRONTEND_STAGED=$(echo "$STAGED_FILES" | grep '^frontend/' || true)
if [ -n "$FRONTEND_STAGED" ]; then
    echo "Running frontend type check..."
    if (cd frontend && npx tsc --noEmit 2>/dev/null); then
        pass "tsc --noEmit"
    else
        fail "tsc --noEmit"
    fi
else
    echo "No frontend files staged, skipping tsc"
fi

# 3. Secret leak detection on staged diffs
echo "Scanning for secrets..."
STAGED_DIFF=$(git diff --cached --diff-filter=ACM)
LEAK_PATTERNS='(PRIVATE KEY|aws_secret|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|password\s*=\s*["\x27][^"\x27]{8,})'
if echo "$STAGED_DIFF" | grep -qEi "$LEAK_PATTERNS" 2>/dev/null; then
    echo -e "${RED}WARNING:${NC} Possible secret detected in staged changes."
    echo "Review your diff carefully. If this is a false positive, commit with --no-verify."
    fail "secret leak detection"
else
    pass "no secrets detected"
fi

echo -e "\n${GREEN}All checks passed${NC}"
